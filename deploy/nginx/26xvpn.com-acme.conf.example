# Temporary HTTP-only virtual host used to obtain the first certificate.
# Replace this with 26xvpn.com.conf.example after ACME succeeds.
server {
    listen 80;
    listen [::]:80;
    server_name 26xvpn.com www.26xvpn.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 503;
    }
}

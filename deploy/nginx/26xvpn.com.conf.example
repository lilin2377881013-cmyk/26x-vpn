# Forward the origin-only policy requested by the cashier.
# Every other upstream receives the default protection.
map $upstream_http_referrer_policy $member_referrer_policy {
    default "no-referrer";
    "strict-origin" "strict-origin";
}

# Install the real certificate paths before enabling the HTTPS server block.
# This forwards website requests to Next.js and same-origin /api requests to Go.
# The API stays bound to localhost; PostgreSQL is never exposed by Nginx.

server {
    listen 80;
    server_name 26xvpn.com www.26xvpn.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://26xvpn.com$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name www.26xvpn.com;

    ssl_certificate     /etc/letsencrypt/live/26xvpn.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/26xvpn.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 301 https://26xvpn.com$request_uri;
}

server {
    listen 443 ssl;
    server_name 26xvpn.com;
    # Requires conf.d/26x-website-visits.conf. Preserve the ordinary access log.
    access_log /var/log/nginx/access.log combined;
    access_log /var/log/nginx/26x-visits.log website_visit if=$log_26x_visit;

    ssl_certificate     /etc/letsencrypt/live/26xvpn.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/26xvpn.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    proxy_hide_header Referrer-Policy;
    add_header Referrer-Policy $member_referrer_policy always;
    client_max_body_size 2m;

    # Admin MFA is not implemented. Replace the reserved address with the
    # operator's fixed IP and uncomment it before allowing remote console use.
    # Until then, the web console and its API remain blocked from the public.
    location ^~ /api/v1/admin/ {
        # allow 198.51.100.10/32;
        deny all;
        proxy_pass http://127.0.0.1:8080;
        proxy_read_timeout 195s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ^~ /admin {
        # allow 198.51.100.10/32;
        deny all;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }

    location ^~ /downloads/ {
        alias /var/www/26x-downloads/;
        types {
            application/vnd.android.package-archive apk;
            application/zip zip;
            application/vnd.microsoft.portable-executable exe;
            application/octet-stream dmg;
        }
        default_type application/octet-stream;
        add_header Content-Disposition "attachment" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        autoindex off;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}

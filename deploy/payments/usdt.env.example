# Leave disabled until the real-wallet smoke test and release review pass.
USDT_ACCEPT_PAYMENTS=false
# Set privately on the server. Public address only; NEVER a private key/seed.
USDT_RECEIVE_ADDRESS=
USDT_PUBLIC_ORIGIN=https://26xvpn.com
# Selected fixed prices; review before changing any live merchant configuration.
USDT_PLAN_PRICES={"standard-30d":"5","standard-90d":"12","standard-365d":"35","premium-30d":"10","premium-90d":"24","premium-365d":"75"}
# Mainnet chain-data API key; kept only in the server's protected environment.
TRONGRID_API_KEY=
# Empty for fixed-price mode. Optional alternative: explicit CNY per USDT.
USDT_CNY_RATE=

# Pause new Alipay payments while retaining callbacks and USDT checkout.
ALIPAY_MAINTENANCE=false

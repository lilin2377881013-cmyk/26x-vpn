HTTP_ADDR=127.0.0.1:8080
MIGRATION_DIR=/opt/26x/api/migrations
DATABASE_URL=postgres://26x_app:REPLACE_WITH_URL_SAFE_RANDOM_SECRET@127.0.0.1:5432/26x_control?sslmode=disable
COOKIE_SECURE=true
TRUSTED_ORIGINS=https://26xvpn.com,https://www.26xvpn.com
TRUSTED_PROXY_CIDRS=127.0.0.1/32
CREDENTIAL_ENCRYPTION_KEY=GENERATE_BASE64_ENCODED_32_BYTE_KEY_AND_STORE_OUTSIDE_DATABASE
# Optional same-host managed VLESS endpoint. Enable after configuring a private Xray socket.
# MANAGED_VLESS_ENDPOINT=ENDPOINT_UUID
# MANAGED_VLESS_SOCKET=/run/xray/26x-control.sock
# MANAGED_VLESS_TAG=vless-26x
# MANAGED_VLESS_REQUIRE_LEASE=false
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_PASSWORD_AT_LEAST_16_CHARS

# Operator-provided node management executable.
NODE_COMMAND=/opt/26x-node/bin/26x-node

# Optional support alerts. Set the real values only in /etc/26x/api.env.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_SUPPORT_CHAT_ID=

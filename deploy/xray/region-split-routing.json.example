{
  "outbounds": [
    {
      "tag": "region-direct",
      "protocol": "freedom"
    },
    {
      "tag": "jp-openai",
      "protocol": "vless",
      "settings": {
        "address": "jp-vps.example.com",
        "port": 443,
        "id": "00000000-0000-4000-8000-000000000000",
        "encryption": "none"
      },
      "streamSettings": {
        "network": "raw",
        "security": "tls",
        "tlsSettings": {
          "serverName": "jp-vps.example.com"
        }
      }
    },
    {
      "tag": "us-streaming",
      "protocol": "vless",
      "settings": {
        "address": "us-vps.example.com",
        "port": 443,
        "id": "00000000-0000-4000-8000-000000000000",
        "encryption": "none"
